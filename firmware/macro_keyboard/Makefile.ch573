# CH573 build of the macro keyboard (board SAYO_2B3: USB cable keyboard + BLE HID
# keyboard + status LEDs + battery reading): RISC-V GCC (xPack) + WCH CH573 EVT SDK
# with its BLE library (EXAM/BLE: LIB, HAL/MCU.c + RTC.c, the HID_Keyboard
# profile files; src/hal/ch573/ble_ch573.c takes the place of its APP).
#   mingw32-make -f Makefile.ch573             -> build/ch573/macro_keyboard-SAYO_2B3.bin
#   mingw32-make -f Makefile.ch573 DEMO=1      -> ...-SAYO_2B3-demo.bin: keys set the LED
#                                                 states instead of typing (src/core/bt_app.h)
#   mingw32-make -f Makefile.ch573 full [DEMO=1] -> ...-full.bin: bootloader + app info + app
#                                                 (first install with wchisp; needs approval)
# The app is linked at BOOT_APP_ADDR behind firmware/bootloader_ch573 (numbers
# from its boot_layout.h); later updates go through that bootloader (gui/core/hidboot.py).
# Nothing here flashes. After editing this file delete build/ch573.
.RECIPEPREFIX = >

MK_CH57X_SDK ?= C:/Users/user/tools/sdk_ch573/EVT
SDK ?= $(MK_CH57X_SDK)
EXAM := $(SDK)/EXAM
DRV := $(EXAM)/SRC/StdPeriphDriver
BLE := $(EXAM)/BLE
KBD := $(BLE)/HID_Keyboard
SDK_LD := $(EXAM)/SRC/Ld/Link.ld
BL_DIR := ../bootloader_ch573
BOARD := SAYO_2B3
DEMO ?= 0
DIAG ?= 0 # BLE input diagnostic: keys show the HID send state on the LEDs
SLOT_ADDR ?= 1 # 0 = A/B test: chip MAC (BLE_MAC=FALSE), no per-slot address
# Config store in Data-Flash (RAM: one copy in storage.c, BOARD_STORE_ONE_BUFFER)
STORE_SIZE := 2048
# BLE stack heap (SDK config.h BLE_MEMHEAP_SIZE, 6 KB there; the library wants
# 4 KB at least). 5 KB: one link only, and the 18 KB of RAM is nearly full
BLE_HEAP ?= 5120
# RAM left free between .bss and the stack reserve (512 B), checked after linking
RAM_MARGIN := 1024
PYTHON ?= python

layout = $(shell sed -n 's/^\#define $(1) \(0x[0-9A-Fa-f]*\)u.*/\1/p' $(BL_DIR)/boot_layout.h)
APP_ADDR := $(call layout,BOOT_APP_ADDR)
FLASH_SIZE := $(call layout,BOOT_FLASH_SIZE)
APP_MAX := $(shell echo $$(($(FLASH_SIZE) - $(APP_ADDR))))
APP_LEN := $(shell printf '0x%X' $(APP_MAX))

SUFFIX := $(if $(filter 1,$(DEMO)),-demo,)$(if $(filter 0,$(SLOT_ADDR)),-noaddr,)$(if $(filter 1,$(DIAG)),-diag,)
TARGET := macro_keyboard-$(BOARD)$(SUFFIX)
OUT := build/ch573
BUILD := $(OUT)/obj-$(BOARD)$(SUFFIX)
BIN := $(OUT)/$(TARGET).bin
FULL := $(OUT)/$(TARGET)-full.bin
BL_BIN := $(BL_DIR)/build/bootloader-$(BOARD).bin
PREFIX ?= $(if $(MK_RISCV_BIN),$(MK_RISCV_BIN)/)riscv-none-elf-
CC := $(PREFIX)gcc
OBJCOPY := $(PREFIX)objcopy
SIZE := $(PREFIX)size
NM := $(PREFIX)nm

ARCH := -march=rv32imac_zicsr_zifencei -mabi=ilp32 -msmall-data-limit=8 -mno-save-restore
# SLOT_ADDR=1 (default): each slot advertises its own static random address, set
# with GAP_ConfigDeviceAddr(ADDRTYPE_STATIC, ...) in GAPROLE_STARTED
# (src/hal/ch573/ble_ch573.c). SLOT_ADDR=0 keeps the chip's public address (A/B).
DEFS := -DMK_CHIP_CH573 -DBOARD_HEADER='"hal/ch573/sayo_2b3.h"' -DBLOB_CAPACITY=$(STORE_SIZE) \
        -DBTLED_DEMO=$(DEMO) -DBLE_DIAG=$(DIAG) -DSLOT_ADDR=$(SLOT_ADDR) \
        -DBLE_MEMHEAP_SIZE=$(BLE_HEAP) $(EXTRA_DEFS)
CFLAGS := $(ARCH) $(DEFS) -MMD -MP -Os -g -ffunction-sections -fdata-sections -fno-common \
          -Wall -Wextra -Wno-unused-parameter
ASFLAGS := $(ARCH) -x assembler-with-cpp
INCS := -Isrc -Isrc/core -Isrc/hal/ch573 -I$(DRV)/inc -I$(EXAM)/SRC/RVMSIS
# SDK BLE files: their own include path, without src ("CONFIG.h" is the SDK's
# HAL/include/config.h; Windows does not tell it from src/config.h)
BLE_INCS := -I$(KBD)/Profile/include -I$(KBD)/APP/include -I$(BLE)/HAL/include -I$(BLE)/LIB -I$(DRV)/inc -I$(EXAM)/SRC/RVMSIS
LDSCRIPT := $(BUILD)/app.ld
# --wrap=CH57X_BLEInit: our __wrap_CH57X_BLEInit (src/hal/ch573/ble_ch573.c)
# replaces the SDK's BLE config init so SNVNum can be set for multi-slot bonds
LDFLAGS := $(ARCH) -T $(LDSCRIPT) -nostartfiles -Wl,--gc-sections -Wl,-Map=$(BUILD)/$(TARGET).map \
           -Wl,--wrap=CH57X_BLEInit --specs=nano.specs --specs=nosys.specs

SRCS_ASM := startup_CH573.S
SRCS_C := app.c input.c led.c lock.c macro.c protocol.c storage.c battery.c bt_led.c bt_app.c \
          hal_ch573.c led_ch573.c battery_ch573.c main.c ble_ch573.c \
          core_riscv.c CH57x_clk.c CH57x_gpio.c CH57x_sys.c CH57x_timer0.c CH57x_pwr.c CH57x_adc.c
# SDK BLE sources as they are (--gc-sections drops what is not used)
SRCS_BLE := MCU.c RTC.c hiddev.c hidkbdservice.c battservice.c devinfoservice.c scanparamservice.c

# vpath per type (src/hal/ch32v203 has a main.c too: not searched)
vpath %.c src/core src/hal/ch573 $(EXAM)/SRC/RVMSIS $(DRV) $(BLE)/HAL $(KBD)/Profile
vpath %.S $(EXAM)/SRC/Startup
BLE_OBJS := $(addprefix $(BUILD)/,$(SRCS_BLE:.c=.o))
OBJS := $(addprefix $(BUILD)/,$(SRCS_C:.c=.o) $(SRCS_ASM:.S=.o)) $(BLE_OBJS)
# SDK BLE files: SDK include path only, SDK warnings off; ble_ch573.c: SDK path first
$(BLE_OBJS): INCS := $(BLE_INCS)
$(BLE_OBJS): CFLAGS += -w
$(BUILD)/ble_ch573.o: INCS := $(BLE_INCS) -Isrc

all: $(BIN)
full: $(FULL)

# SDK link script with the app at BOOT_APP_ADDR
$(LDSCRIPT): $(SDK_LD) Makefile.ch573 $(BL_DIR)/boot_layout.h | $(BUILD)
> sed -e 's/ORIGIN = 0x00000000, LENGTH = 448K/ORIGIN = $(APP_ADDR), LENGTH = $(APP_LEN)/' $< > $@
> grep -q 'ORIGIN = $(APP_ADDR)' $@

$(BUILD)/$(TARGET).elf: $(OBJS) $(LDSCRIPT)
> $(CC) $(LDFLAGS) -o $@ $(OBJS) $(BLE)/LIB/libCH57xBLE.a $(DRV)/libISP573.a -lc -lgcc -lm
> $(SIZE) $@
> @ebss=$$($(NM) $@ | sed -n 's/^\([0-9a-f]*\) . _ebss$$/\1/p'); \
  top=$$($(NM) $@ | sed -n 's/^\([0-9a-f]*\) . _eusrstack$$/\1/p'); \
  size=$$($(NM) $@ | sed -n 's/^\([0-9a-f]*\) . __stack_size$$/\1/p'); \
  free=$$((0x$$top - 0x$$size - 0x$$ebss)); echo "RAM free above .bss: $$free bytes (+ 512 B stack)"; \
  if [ $$free -lt $(RAM_MARGIN) ]; then echo "ERROR: less than $(RAM_MARGIN) B of RAM free"; rm -f $@; exit 1; fi

$(BIN): $(BUILD)/$(TARGET).elf
> $(OBJCOPY) -O binary $< $@
> @n=$$(wc -c < $@); if [ $$n -gt $(APP_MAX) ]; then echo "ERROR: app $$n bytes > $(APP_MAX)"; rm -f $@; exit 1; fi
> @echo "$@: $$(wc -c < $@) bytes"

$(BL_BIN): FORCE
> $(MAKE) -C $(BL_DIR) BOARD=$(BOARD)

$(FULL): $(BIN) $(BL_BIN) $(BL_DIR)/mkfull.py
> $(PYTHON) $(BL_DIR)/mkfull.py $(BL_BIN) $(BIN) $@

# Stock GCC does not know the WCH interrupt attribute; "machine" gives the same mret
$(BUILD)/src/%.c: %.c | $(BUILD)/src
> sed -e 's/WCH-Interrupt-fast/machine/g' $< > $@

$(BUILD)/%.o: $(BUILD)/src/%.c | $(BUILD)
> $(CC) $(CFLAGS) $(INCS) -c $< -o $@

$(BUILD)/%.o: %.S | $(BUILD)
> $(CC) $(ASFLAGS) -c $< -o $@

$(BUILD) $(BUILD)/src:
> mkdir -p $@

-include $(OBJS:.o=.d)

clean:
> rm -rf $(BUILD) $(BIN) $(FULL)

FORCE:
.PHONY: all full clean FORCE
.SECONDARY:
