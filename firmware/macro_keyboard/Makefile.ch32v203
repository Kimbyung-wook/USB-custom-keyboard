# CH32V203 build of the macro keyboard (board SAYO_3X3): RISC-V GCC (xPack) + WCH EVT SDK.
#   mingw32-make -f Makefile.ch32v203            -> build/ch32v203/macro_keyboard-SAYO_3X3.bin (objects: build/ch32v203/obj-SAYO_3X3)
#   mingw32-make -f Makefile.ch32v203 flash      -> wchisp flash (BOOT bridge, BOOTLOADER=0 only)
# BOOTLOADER=1 (default): app at 0x08002000 behind firmware/bootloader_ch32v203
#   (install: that folder's `make flash` once, then gui/core/hidboot.py).
# BOOTLOADER=0: app at 0x08000000 without a bootloader (old layout, wchisp only).
# After editing this file run `rm -rf build` (make removes build/src/*.c).
# Sources are copied flat into build/src: -Isrc/core resolves core's "../hal/hal.h"
.RECIPEPREFIX = >

# Tool paths: environment MK_EVT_SDK, MK_RISCV_BIN (folder of riscv-none-elf-gcc,
# else PATH), MK_WCHISP; otherwise these defaults (same in tools/*.ps1)
MK_EVT_SDK ?= C:/Users/user/tools/sdk/EVT
SDK ?= $(MK_EVT_SDK)
EXAM := $(SDK)/EXAM
PERIPH := $(EXAM)/SRC/Peripheral
SDK_LD := $(EXAM)/SRC/Ld/Link.ld
BOARD ?= SAYO_3X3
BOOTLOADER ?= 1
# Config storage at the end of the 64 KB flash (src/config.h BLOB_CAPACITY)
STORE_SIZE := 4096
ifeq ($(BOOTLOADER),1)
# 0x2000..0xEEFF; app info page at 0xEF00 (src/hal/ch32v203/boot_layout.h)
IMAGE_MAX := 52992
LD_SED := -e 's/ORIGIN = 0x00000000, LENGTH = 64K/ORIGIN = 0x00002000, LENGTH = 52992/'
else
IMAGE_MAX := $(shell expr 65536 - $(STORE_SIZE))
LD_SED :=
endif

TARGET := macro_keyboard-$(BOARD)
# The .bin of every board sits in OUT; objects per board in OUT/obj-<BOARD>,
# so building one board leaves the others' files alone
OUT := build/ch32v203
BUILD := $(OUT)/obj-$(BOARD)
BIN := $(OUT)/$(TARGET).bin
PREFIX ?= $(if $(MK_RISCV_BIN),$(MK_RISCV_BIN)/)riscv-none-elf-
CC := $(PREFIX)gcc
OBJCOPY := $(PREFIX)objcopy
SIZE := $(PREFIX)size
WCHISP ?= $(or $(MK_WCHISP),wchisp)

ARCH := -march=rv32imac_zicsr_zifencei -mabi=ilp32 -msmall-data-limit=8
DEFS := -DSYSCLK_FREQ_48MHz_HSI -DBOARD_$(BOARD) -DBLOB_CAPACITY=$(STORE_SIZE) -DBOOTLOADER=$(BOOTLOADER) $(EXTRA_DEFS)
CFLAGS := $(ARCH) $(DEFS) -MMD -MP -Os -g -ffunction-sections -fdata-sections -Wall -Wextra -Wno-unused-parameter -Wno-unterminated-string-initialization
ASFLAGS := $(ARCH) -x assembler-with-cpp
USBD := src/hal/ch32v203/usb
USERD := $(EXAM)/USB/USBFS/DEVICE/CompositeKM/User # system_ch32v20x, ch32v20x_it (USB files are patched in $(USBD))
INCS := -Isrc -Isrc/core -Isrc/hal/ch32v203 -I$(USBD) -I$(EXAM)/SRC/Core -I$(PERIPH)/inc -I$(EXAM)/SRC/Debug -I$(USERD)
LDSCRIPT := $(BUILD)/link.ld
LDFLAGS := $(ARCH) -T $(LDSCRIPT) -nostartfiles -Wl,--gc-sections -Wl,-Map=$(BUILD)/$(TARGET).map

SRCS_ASM := startup_ch32v20x_D6.S
SRCS_C := app.c input.c led.c lock.c macro.c protocol.c storage.c \
          hal_ch32v203.c main.c ch32v20x_usbfs_device.c usbd_desc.c \
          core_riscv.c system_ch32v20x.c ch32v20x_it.c \
          ch32v20x_gpio.c ch32v20x_rcc.c ch32v20x_misc.c ch32v20x_tim.c ch32v20x_flash.c \
          ch32v20x_usart.c ch32v20x_dma.c debug.c ch32v20x_exti.c ch32v20x_pwr.c

VPATH := src/core src/hal/ch32v203 $(USBD) $(EXAM)/SRC/Startup $(EXAM)/SRC/Core $(EXAM)/SRC/Debug $(PERIPH)/src $(USERD)
OBJS := $(addprefix $(BUILD)/,$(SRCS_C:.c=.o) $(SRCS_ASM:.S=.o))


all: $(BIN)

# RAM ends 16 bytes early: the bootloader RAM mark sits above the stack
$(LDSCRIPT): $(SDK_LD) Makefile.ch32v203 | $(BUILD)
> sed $(LD_SED) -e 's/LENGTH = 20K/LENGTH = 0x4FF0/' $< > $@

$(BUILD)/$(TARGET).elf: $(OBJS) $(LDSCRIPT)
> $(CC) $(LDFLAGS) -o $@ $(OBJS) -lc -lgcc
> $(SIZE) $@

$(BIN): $(BUILD)/$(TARGET).elf
> $(OBJCOPY) -O binary $< $@
# The last STORE_SIZE bytes of flash hold the config: the image must end before them
> @n=$$(wc -c < $@); if [ $$n -gt $(IMAGE_MAX) ]; then echo "ERROR: image $$n bytes overlaps the config ($(STORE_SIZE) bytes at the flash end)"; rm -f $@; exit 1; fi

# Stock GCC does not know the WCH interrupt attribute; "machine" gives the same
# prologue and mret. SYSCLK 96 MHz HSE is commented out (USB needs the 48 MHz HSI setup).
$(BUILD)/src/%.c: %.c | $(BUILD)/src
> sed -e 's/WCH-Interrupt-fast/machine/g' -e 's|^#define SYSCLK_FREQ_96MHz_HSE|//&|' $< > $@

$(BUILD)/%.o: $(BUILD)/src/%.c | $(BUILD)
> $(CC) $(CFLAGS) $(INCS) -c $< -o $@

# CSR 0xbc0 looks write-once (the ISP bootloader writes it too): not in the startup file
$(BUILD)/src/%.S: %.S | $(BUILD)/src
> sed -e '/csrw[[:space:]]*0xbc0/d' $< > $@

$(BUILD)/%.o: $(BUILD)/src/%.S | $(BUILD)
> $(CC) $(ASFLAGS) $(INCS) -c $< -o $@

$(BUILD) $(BUILD)/src:
> mkdir -p $@

flash: $(BIN)
> @if [ "$(BOOTLOADER)" = 1 ]; then echo "BOOTLOADER=1: use firmware/bootloader_ch32v203 (make flash) or hidboot"; exit 1; fi
> $(WCHISP) flash $<

# Header dependencies (-MMD -MP): a changed header rebuilds its objects
-include $(OBJS:.o=.d)

clean:
> rm -rf $(BUILD) $(BIN)

.PHONY: all flash clean
