# CH32V203 build of the macro keyboard (board 3X3V_RGB): RISC-V GCC (xPack) + WCH EVT SDK.
#   mingw32-make -f Makefile.ch32v203            -> build/macro_keyboard-3X3V_RGB.bin
#   mingw32-make -f Makefile.ch32v203 flash      -> wchisp flash (BOOT bridge connected)
# After editing this file run `rm -rf build` (make removes build/src/*.c).
# Sources are copied flat into build/src: -Isrc/core resolves core's "../hal/hal.h"
.RECIPEPREFIX = >

SDK ?= C:/Users/user/tools/sdk/EVT
EXAM := $(SDK)/EXAM
PERIPH := $(EXAM)/SRC/Peripheral
LDSCRIPT := $(EXAM)/SRC/Ld/Link.ld
BOARD ?= 3X3V_RGB
# Config storage at the end of the 64 KB flash (src/config.h BLOB_CAPACITY)
STORE_SIZE := 4096
IMAGE_MAX := $(shell expr 65536 - $(STORE_SIZE))

TARGET := macro_keyboard-$(BOARD)
BUILD := build/ch32v203
PREFIX ?= riscv-none-elf-
CC := $(PREFIX)gcc
OBJCOPY := $(PREFIX)objcopy
SIZE := $(PREFIX)size
WCHISP ?= wchisp

ARCH := -march=rv32imac_zicsr_zifencei -mabi=ilp32 -msmall-data-limit=8
DEFS := -DSYSCLK_FREQ_48MHz_HSI -DBOARD_$(BOARD) -DBLOB_CAPACITY=$(STORE_SIZE) $(EXTRA_DEFS)
CFLAGS := $(ARCH) $(DEFS) -Os -g -ffunction-sections -fdata-sections -Wall -Wextra -Wno-unused-parameter -Wno-unterminated-string-initialization
ASFLAGS := $(ARCH) -x assembler-with-cpp
USBD := src/hal/ch32v203/usb
USERD := $(EXAM)/USB/USBFS/DEVICE/CompositeKM/User # system_ch32v20x, ch32v20x_it (USB files are patched in $(USBD))
INCS := -Isrc -Isrc/core -I$(USBD) -I$(EXAM)/SRC/Core -I$(PERIPH)/inc -I$(EXAM)/SRC/Debug -I$(USERD)
LDFLAGS := $(ARCH) -T $(LDSCRIPT) -nostartfiles -Wl,--gc-sections -Wl,-Map=$(BUILD)/$(TARGET).map

SRCS_ASM := startup_ch32v20x_D6.S
SRCS_C := app.c input.c led.c lock.c macro.c protocol.c storage.c \
          hal_ch32v203.c main.c ch32v20x_usbfs_device.c usbd_desc.c \
          core_riscv.c system_ch32v20x.c ch32v20x_it.c \
          ch32v20x_gpio.c ch32v20x_rcc.c ch32v20x_misc.c ch32v20x_tim.c ch32v20x_flash.c \
          ch32v20x_usart.c ch32v20x_dma.c debug.c ch32v20x_exti.c ch32v20x_pwr.c

VPATH := src/core src/hal/ch32v203 $(USBD) $(EXAM)/SRC/Startup $(EXAM)/SRC/Core $(EXAM)/SRC/Debug $(PERIPH)/src $(USERD)
OBJS := $(addprefix $(BUILD)/,$(SRCS_C:.c=.o) $(SRCS_ASM:.S=.o))

all: $(BUILD)/$(TARGET).bin

$(BUILD)/$(TARGET).elf: $(OBJS) $(LDSCRIPT)
> $(CC) $(LDFLAGS) -o $@ $(OBJS) -lc -lgcc
> $(SIZE) $@

$(BUILD)/$(TARGET).bin: $(BUILD)/$(TARGET).elf
> $(OBJCOPY) -O binary $< $@
# The last STORE_SIZE bytes of flash hold the config: the image must end before them
> @n=$$(wc -c < $@); if [ $$n -gt $(IMAGE_MAX) ]; then echo "ERROR: image $$n bytes overlaps the config ($(STORE_SIZE) bytes at the flash end)"; rm -f $@; exit 1; fi

# Stock GCC does not know the WCH interrupt attribute; "machine" gives the same
# prologue and mret. SYSCLK 96 MHz HSE is commented out (USB needs the 48 MHz HSI setup).
$(BUILD)/src/%.c: %.c | $(BUILD)/src
> sed -e 's/WCH-Interrupt-fast/machine/g' -e 's|^#define SYSCLK_FREQ_96MHz_HSE|//&|' $< > $@

$(BUILD)/%.o: $(BUILD)/src/%.c | $(BUILD)
> $(CC) $(CFLAGS) $(INCS) -c $< -o $@

# CSR 0xbc0 looks write-once (the ISP bootloader writes it too): not in the startup file
$(BUILD)/src/%.S: %.S | $(BUILD)/src
> sed -e '/csrw[[:space:]]*0xbc0/d' $< > $@

$(BUILD)/%.o: $(BUILD)/src/%.S | $(BUILD)
> $(CC) $(ASFLAGS) $(INCS) -c $< -o $@

$(BUILD) $(BUILD)/src:
> mkdir -p $@

flash: $(BUILD)/$(TARGET).bin
> $(WCHISP) flash $<

clean:
> rm -rf $(BUILD)

.PHONY: all flash clean
